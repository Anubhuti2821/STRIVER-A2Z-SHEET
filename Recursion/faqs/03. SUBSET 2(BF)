class Solution {
public:
    set<vector<int>> st;

    vector<vector<int>> subsetsWithDup(vector<int>& nums) {
        vector<int> s;
        helper(nums, 0, s);

        vector<vector<int>> ans(st.begin(), st.end());
        return ans;
    }

    void helper(vector<int>& nums, int i, vector<int> s) {
        if (i == nums.size()) {
            sort(s.begin(), s.end());
            st.insert(s);
            return;
        }

        // TAKE
        s.push_back(nums[i]);
        helper(nums, i + 1, s);

        // NOT TAKE
        s.pop_back();
        helper(nums, i + 1, s);
    }
};
