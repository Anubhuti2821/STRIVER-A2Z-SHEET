// Problem: Count Inversions
// Brute Force Approach

class Solution {
public:
    long long int numberOfInversions(vector<int>& nums) {
        long long count = 0;
        int n = nums.size();

        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                if (nums[i] > nums[j]) {
                    count++;
                }
            }
        }

        return count;
    }
};

/*
Time Complexity: O(n²)
Space Complexity: O(1)

Important Notes:
- An inversion is a pair (i, j) such that:
  i < j && nums[i] > nums[j].
- Compare every element with all elements to its right.
- Increment the count whenever an inversion is found.

Possible Optimization:
- Use Merge Sort to count inversions in O(n log n) time.
*/
