/*
Problem: Merge Intervals (LeetCode 56)

Given an array of intervals where intervals[i] = [starti, endi],
merge all overlapping intervals and return an array of the non-overlapping intervals.
*/

class Solution {
public:
    vector<vector<int>> merge(vector<vector<int>>& intervals) {
        if(intervals.empty()) return {};

        sort(intervals.begin(), intervals.end());

        vector<vector<int>> res;
        int n = intervals.size();

        for(int i = 0; i < n; i++) {
            int st = intervals[i][0];
            int end = intervals[i][1];

            while(i + 1 < n && end >= intervals[i + 1][0]) {
                end = max(end, intervals[i + 1][1]);
                i++;
            }

            res.push_back({st, end});
        }

        return res;
    }
};

/*
Time Complexity: O(n log n)
- Sorting takes O(n log n).
- Traversing and merging intervals takes O(n).

Space Complexity: O(1) (excluding the output vector)
- Only a few extra variables are used.
- The output vector is not counted as extra space.
*/

/*
Important Notes:
- Sort intervals based on their starting point before merging.
- Maintain the current merged interval using 'st' and 'end'.
- Extend 'end' while the next interval overlaps.
- Increment 'i' inside the while loop to skip already merged intervals.
*/

