//print all substring
#include<iostream>
#include<string>
using namespace std;

int main() {
    string s;
    cin >> s;

    int n = s.size();

    for(int i = 0; i < n; i++) {
        for(int j = i; j < n; j++) {
            cout << s.substr(i, j - i + 1) << endl;
        }
    }

    return 0;
}
