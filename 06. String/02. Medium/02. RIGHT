// Problem: Maximum Nesting Depth of the Parentheses

// My Mistake:
// I used separate counters for '(' and ')'.
// I was counting consecutive brackets instead of tracking the actual
// number of open parentheses at a given point.

// Learning:
// Use one variable to maintain current depth.
// '(' increases depth by 1 and ')' decreases depth by 1.
// The maximum depth reached during traversal is the answer.

// Optimization:
// The solution is already optimal.
// Time Complexity: O(n) because every character is visited once.
// Space Complexity: O(1) because only constant extra variables are used.

class Solution {
public:
    int maxDepth(string s) {
        int depth = 0;
        int max_depth = 0;

        for(int i = 0; i < s.size(); i++) {
            if(s[i] == '(') {
                depth++;
                max_depth = max(max_depth, depth);
            }
            else if(s[i] == ')') {
                depth--;
            }
        }

        return max_depth;
    }
};

/*
TIME COMPLEXITY: O(n)
SPACE COMPLEXITY: O(1)
*/
