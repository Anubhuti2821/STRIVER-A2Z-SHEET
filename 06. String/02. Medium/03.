// Problem: Roman to Integer
// Approach: Check valid subtractive pairs first, otherwise add individual values.

// My Mistake:
// I handled all possible combinations with 'I' (like IL, IC, ID, IM),
// but those are invalid Roman numeral rules.
// Also, I used multiple independent if statements, which could process
// the same character more than once.

// Learning:
// There are only 6 valid subtractive pairs:
// IV = 4, IX = 9, XL = 40, XC = 90, CD = 400, CM = 900.
// After finding a pair, skip the next character using i++.

// Optimization:
// The approach is optimal for this method.
// Time Complexity: O(n) because each character is processed once.
// Space Complexity: O(1) because no extra data structure is used.

class Solution {
public:
    int romanToInt(string s) {
        int n = s.size();
        int no = 0;

        for(int i = 0; i < n; i++) {

            if(i < n-1 && s[i] == 'I' && s[i+1] == 'V') {
                no += 4;
                i++;
            }
            else if(i < n-1 && s[i] == 'I' && s[i+1] == 'X') {
                no += 9;
                i++;
            }
            else if(i < n-1 && s[i] == 'X' && s[i+1] == 'L') {
                no += 40;
                i++;
            }
            else if(i < n-1 && s[i] == 'X' && s[i+1] == 'C') {
                no += 90;
                i++;
            }
            else if(i < n-1 && s[i] == 'C' && s[i+1] == 'D') {
                no += 400;
                i++;
            }
            else if(i < n-1 && s[i] == 'C' && s[i+1] == 'M') {
                no += 900;
                i++;
            }
            else if(s[i] == 'I') {
                no += 1;
            }
            else if(s[i] == 'V') {
                no += 5;
            }
            else if(s[i] == 'X') {
                no += 10;
            }
            else if(s[i] == 'L') {
                no += 50;
            }
            else if(s[i] == 'C') {
                no += 100;
            }
            else if(s[i] == 'D') {
                no += 500;
            }
            else if(s[i] == 'M') {
                no += 1000;
            }
        }

        return no;
    }
};

/*
TIME COMPLEXITY: O(n)
SPACE COMPLEXITY: O(1)
*/
