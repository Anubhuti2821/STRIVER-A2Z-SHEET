// Problem: Maximum Nesting Depth of the Parentheses
// Approach: Using two separate counters for '(' and ')' (Incorrect Approach)

class Solution {
public:
    int maxDepth(string s) {
        int n = s.size();
        int t = 0;
        int count = 0;
        int count2 = 0;
        int max_depth = 0;

        for(int i = 0; i < n; i++) {
            if(isalnum(s[i])) {
                continue;
            }

            if(s[i] == ')') {
                count++;

                max_depth = max(max_depth, count);

                count2 = 0;
            }
            else if(s[i] == '(') {
                count2++;

                max_depth = max(max_depth, count2);

                count = 0;
            }
        }

        return max_depth;
    }
};

/*
TIME COMPLEXITY: O(n)
SPACE COMPLEXITY: O(1)
*/
